{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "seo.audit_site",
  "type": "object",
  "required": [
    "base_url"
  ],
  "properties": {
    "base_url": {
      "type": "string",
      "format": "uri"
    },
    "max_pages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 100
    },
    "respect_robots": {
      "type": "boolean",
      "default": true
    }
  }
}
